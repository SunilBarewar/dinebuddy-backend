# ── Server ─────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3000
HOST=0.0.0.0

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/restaurant_db

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave blank to allow localhost in dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Observability (HyperDX) ─────────────────────────────
# Get your ingestion API key from https://app.hyperdx.io/team
# Leave unset in development – the HyperDX transport is skipped when absent.
# HYPERDX_API_KEY=your_hyperdx_ingestion_api_key

# Override the log level (default: "info" in production, "debug" in development)
# LOG_LEVEL=info
