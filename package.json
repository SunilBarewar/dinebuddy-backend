{
  "name": "restaurant-management-backend",
  "version": "1.0.0",
  "description": "Restaurant Management System Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/src/index.js",
    "build": "npm run typecheck && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seeders/floor-table.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "restaurant",
    "backend",
    "api"
  ],
  "prisma": {
    "seed": "tsx prisma/seeders/floor-table.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.2.3",
    "@types/winston": "^2.4.4",
    "eslint": "^9.39.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-perfectionist": "^5.5.0",
    "globals": "^17.3.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "prisma": "^7.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "dependencies": {
    "@hyperdx/node-opentelemetry": "^0.10.2",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.18.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6",
    "zod-express-validator": "^0.0.6"
  }
}
