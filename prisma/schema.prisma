generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]

  @@map("restaurants")
}

model Branch {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  address      String
  city         String
  state        String
  gstNumber    String   @map("gst_number")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floors     Floor[]
  tables     Table[]

  @@index([restaurantId])
  @@map("branches")
}

model Floor {
  id           String   @id @default(cuid())
  branchId     String
  name         String
  displayOrder Int
  createdAt    DateTime @default(now())

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables Table[]

  @@index([branchId])
  @@map("floors")
}

model Table {
  id          String   @id @default(cuid())
  branchId    String
  floorId     String
  tableNumber Int
  status      String
  posX        Int
  posY        Int
  shape       String
  createdAt   DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floor  Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([floorId])
  @@unique([floorId, tableNumber])
  @@map("tables")
}
